# ==================================================
# Supabase
# ==================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================================================
# App
# ==================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable demo mode in production (default: false, demo only runs in development)
# NEXT_PUBLIC_ENABLE_DEMO=true

# Enable the migration API endpoint (NEVER set in production)
# ENABLE_MIGRATION_API=true
# One-time token required when migration API is enabled (generate with: openssl rand -hex 32)
# MIGRATION_TOKEN=your_one_time_migration_token

# Twilio SMS webhook URL (for signature validation; defaults to NEXT_PUBLIC_APP_URL/api/sms/webhook)
# TWILIO_SMS_WEBHOOK_URL=https://your-app.com/api/sms/webhook

# ==================================================
# Moodle LMS Integration
# ==================================================
# Base URL of your Moodle instance (without trailing slash)
MOODLE_BASE_URL=https://your-moodle-instance.com
# Moodle Web Service API token (generate from Site Admin > Plugins > Web Services > Manage Tokens)
MOODLE_API_TOKEN=your_moodle_api_token
# Course IDs for placement tests (optional, defaults to 1, 2, 3)
MOODLE_ENGLISH_COURSE_ID=1
MOODLE_MATH_COURSE_ID=2
MOODLE_COMPUTER_COURSE_ID=3

# ==================================================
# MyFatoorah Payment Gateway
# ==================================================
# API key from MyFatoorah merchant dashboard
MYFATOORAH_API_KEY=your_myfatoorah_api_key
# Base URL: https://api.myfatoorah.com (production) or https://apitest.myfatoorah.com (test)
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
# Webhook secret for verifying payment callbacks (REQUIRED for webhook security)
MYFATOORAH_WEBHOOK_SECRET=your_webhook_secret

# ==================================================
# Twilio (SMS & Voice)
# ==================================================
# Account SID from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
# Auth Token from https://console.twilio.com
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio phone number for sending SMS (E.164 format, e.g. +19876543210)
TWILIO_PHONE_NUMBER=+1234567890

# ==================================================
# CRON Jobs
# ==================================================
# Secret token for authenticating scheduled cron jobs (SMS reminders, etc.)
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# ==================================================
# Avaya PBX Integration
# ==================================================
# Webhook secret for verifying Avaya callback events
AVAYA_WEBHOOK_SECRET=your_avaya_webhook_secret

# ==================================================
# OpenAI (AI Features)
# ==================================================
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ==================================================
# Email (SMTP) — Registration Notifications
# ==================================================
# SMTP server (e.g. smtp.gmail.com, smtp.office365.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Optional: custom "from" address (defaults to SMTP_USER)
# SMTP_FROM=noreply@ktech.edu
# Email address of the registration department
REGISTRATION_EMAIL=registration@ktech.edu

# ==================================================
# Webhook secrets (REQUIRED in production)
# ==================================================
# n8n AI-transfer webhook (signs payloads delivered to /api/webhooks/ai-transfer)
AI_TRANSFER_WEBHOOK_SECRET=your_ai_transfer_webhook_secret
# Finance department webhook secret (used by /api/payments/finance/webhook)
# FINANCE_WEBHOOK_SECRET=your_finance_webhook_secret

# ==================================================
# Upstash Redis (REQUIRED in production)
# Used for: cron run claim locks, automation re-entry locks, rate-limiter.
# Without Upstash, dedup falls back to per-instance memory only.
# ==================================================
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ==================================================
# Sentry (REQUIRED in production)
# ==================================================
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn
# Optional, enables source-map upload during build
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=your_auth_token

# ==================================================
# Origin allowlist (preview deployments)
# Comma-separated list of hostnames permitted as Origin on state-changing routes.
# Required only if you serve preview environments outside the production domain.
# ==================================================
# ALLOWED_ORIGIN_HOSTS=app.adl.edu.kw,staging.adl.edu.kw

# ==================================================
# Demo mode (NEVER enable in production)
# ==================================================
# DEMO_MODE_ENABLED=true
# DEMO_ADMIN_PASSWORD=
# DEMO_AGENT_PASSWORD=

# ==================================================
# Optional: deep health-check token
# Gates verbose dependency checks at /api/health?verbose=1
# ==================================================
# HEALTH_TOKEN=your_health_token
